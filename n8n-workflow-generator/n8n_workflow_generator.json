    {
      "parameters": {
        "jsCode": "/*****************************************************************\n * Validate Tools-Agent wiring\n *  - OpenAI Chat Model is required & wired via ai_languageModel\n *  - PGVector node is optional; if present it must be wired via ai_tool\n *  - Final workflow object is returned in  items[0].json.output\n *****************************************************************/\n\n// 1 ── Parse the generator’s text into a workflow object ────────\nlet raw = items[0].json.output ?? items[0].json;          // string or object\nif (typeof raw === 'string') {\n  raw = raw.replace(/```json|```/g, '').trim();           // strip fences\n  raw = JSON.parse(raw);\n}\nconst wf = raw;                                           // workflow object\n\n// 2 ── Helper look-ups ──────────────────────────────────────────\nconst cx            = wf.connections ?? {};\nconst nodesByName   = Object.fromEntries(wf.nodes.map(n => [n.name, n]));\nconst agentNodes    = wf.nodes.filter(n => n.type === '@n8n/n8n-nodes-langchain.agent');\n\nif (agentNodes.length === 0) {\n  // No Tools Agent → nothing to validate\n  return [{ json: { output: wf } }];\n}\nif (agentNodes.length > 1) {\n  throw new Error('More than one Tools Agent found');\n}\nconst agentName = agentNodes[0].name;\n\n// helper: check if “fromNode” links to agent via “port”\nconst linked = (fromNode, port) =>\n  cx[fromNode]?.[port]?.some(l => l.node === agentName);\n\n// 3 ── Mandatory Chat Model ────────────────────────────────────\nif (!nodesByName['OpenAI Chat Model']) {\n  throw new Error('Tools Agent present but OpenAI Chat Model node missing');\n}\nif (!linked('OpenAI Chat Model', 'ai_languageModel')) {\n  throw new Error('OpenAI Chat Model not connected to Tools Agent');\n}\n\n// 4 ── Optional PGVector: if present it must be wired correctly ─\nif (nodesByName['wfs Postgres PGVector'] &&\n    !linked('wfs Postgres PGVector', 'ai_tool')) {\n  throw new Error('PGVector node present but not connected to Tools Agent');\n}\n\n// 5 ── Everything is fine → pass workflow in .output ───────────\nreturn [{ json: { output: wf } }];\n"
      },
